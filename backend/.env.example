PORT=3002

MONGO_URI=mongodb://localhost:27017/cobranza-ai

# ─── Auth ────────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Meta / WhatsApp Business API ─────────────────────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Twilio Voice ──────────────────────────────────────────────
# Obtén estos valores en: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio asignado (opcional en cuenta Trial sin número)
TWILIO_PHONE_NUMBER=

# ─── Anthropic Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── OpenAI Realtime (voz del agente en llamadas) ──────────────────────────────
# Obtén la key en: https://platform.openai.com/api-keys (necesita acceso a Realtime API)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# SOLO PARA PRUEBAS — salta la verificación de nombre en verify_identity (siempre pasa).
# NUNCA ponerlo en "true" en producción real. Déjalo vacío o quítalo cuando termines de probar.
SKIP_IDENTITY_CHECK=

# ─── URL pública del backend (para callbacks de Twilio en llamadas salientes) ──
# Ej: https://cobranza.rms-iqor-mexico.com
PUBLIC_URL=

# ─── Verificación de pagos (flujo de voz, estado verify_payment) ──────────────
# Opcional. Sin configurar, verify_payment siempre responde "no encontrado".
# Contrato esperado: GET {PAYMENTS_PROVIDER_URL}/verify?clientId=...
#   -> { "exists": boolean, "amount"?: number, "date"?: "YYYY-MM-DD" }
PAYMENTS_PROVIDER_URL=
PAYMENTS_PROVIDER_API_KEY=
