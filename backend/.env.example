PORT=3003

MONGO_URI=mongodb://localhost:27017/cobranza-ai

# ─── Auth ────────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Meta / WhatsApp Business API ─────────────────────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Twilio Voice ──────────────────────────────────────────────
# Obtén estos valores en: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio asignado (opcional en cuenta Trial sin número)
TWILIO_PHONE_NUMBER=

# ─── Anthropic Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── OpenAI Realtime (voz del agente en llamadas) ──────────────────────────────
# Obtén la key en: https://platform.openai.com/api-keys (necesita acceso a Realtime API)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# SOLO PARA PRUEBAS — salta la verificación de nombre en verify_identity (siempre pasa).
# NUNCA ponerlo en "true" en producción real. Déjalo vacío o quítalo cuando termines de probar.
SKIP_IDENTITY_CHECK=

# ─── Grabación de llamadas (diagnóstico de transcripción, opcional) ────────────
# Twilio cobra aparte por esto (~$0.005 USD/min combinando grabación + almacenamiento) —
# apagado por defecto. Prender solo puntualmente para comparar el audio real contra lo
# que transcribió gpt-4o-transcribe (GET /api/voice/:id/recording, requireAuth).
VOICE_CALL_RECORDING_ENABLED=

# ─── Llamadas automáticas de cobranza (opcional) ───────────────────────────────
# Interruptor real está en Settings (UI, con contraseña) — esto solo controla cuántas
# llamadas dispara el scheduler por cada corrida (cada hora en punto, lun-sáb 9am-7pm CDMX).
# Default 12 si se deja vacío. Súbelo/bájalo según cuántas llamadas simultáneas aguante
# tu cuenta de Twilio/OpenAI sin saturarse.
AUTO_CALL_BATCH_SIZE=12
# Con true: (1) el ciclo SOLO corre sobre los clientes marcados "Test Group Calls" en la
# tabla, (2) el cron corre cada minuto sin restricción de horario/día, y (3) los gaps
# entre pasos (normalmente 3 días/1 día) bajan a 1 minuto — para ver el flujo completo de
# 4 pasos en una sola sesión de prueba en vez de esperar una semana real.
# Quitar/poner en false antes de usar con clientes reales.
AUTO_CALL_TEST_MODE=

# ─── URL pública del backend (para callbacks de Twilio en llamadas salientes) ──
# Ej: https://cobranza.rms-iqor-mexico.com
PUBLIC_URL=

# ─── Aviso a agente humano (botón "Notify agent" en Clients) ──────────────────
# Número al que se llama (con TTS) cuando se lanza el aviso de REQUIERE_HUMANO.
# Opcional — si se deja vacío, usa 3319042792 por default.
HUMAN_AGENT_PHONE=

# ─── Verificación de pagos (flujo de voz, estado verify_payment) ──────────────
# Opcional. Sin configurar, verify_payment siempre responde "no encontrado".
# Contrato esperado: GET {PAYMENTS_PROVIDER_URL}/verify?clientId=...
#   -> { "exists": boolean, "amount"?: number, "date"?: "YYYY-MM-DD" }
PAYMENTS_PROVIDER_URL=
PAYMENTS_PROVIDER_API_KEY=

# ─── Piloto de voz: Deepgram (STT) + Claude (LLM) + ElevenLabs (TTS) ──────────
# Camino alterno a OpenAI Realtime, solo para llamadas disparadas con
# POST /api/voice/outbound-cartesia. Ver docs/piloto-voz-llamada-referencia.md.
# ElevenLabs necesita plan de pago (Starter+) para usar voces de la biblioteca por API.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional (default eleven_flash_v2_5):
ELEVENLABS_MODEL=
